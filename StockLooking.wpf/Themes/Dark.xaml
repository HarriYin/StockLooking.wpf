<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Apple 风 · 深色主题共享 Brush 键 -->
    <SolidColorBrush x:Key="AppBgBrush" Color="#1c1c1e"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#2c2c2e"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#f5f5f7"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#98989d"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8e8e93"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3a3a3c"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#3a3a3c"/>
    <SolidColorBrush x:Key="HoverBgBrush" Color="#3a3a3c"/>
    <!-- 分组列表选中态边框：中性灰，比背景略亮，低调且可辨（替代原蓝色 SliderFillBrush） -->
    <SolidColorBrush x:Key="RowSelBorderBrush" Color="#6E6E73"/>
    <SolidColorBrush x:Key="PressedBgBrush" Color="#48484a"/>
    <SolidColorBrush x:Key="TabSelectedBgBrush" Color="#3a3a3c"/>
    <SolidColorBrush x:Key="TabHoverBgBrush" Color="#2a2a2c"/>
    <SolidColorBrush x:Key="DgHeaderBgBrush" Color="#2a2a2c"/>
    <SolidColorBrush x:Key="DgAltRowBrush" Color="#262628"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#3a3a3c"/>
    <SolidColorBrush x:Key="SaveHintBrush" Color="#30d158"/>
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#3a3a3c"/>
    <!-- 盯盘浮窗边框：深色背景下用半透明白描边 -->
    <SolidColorBrush x:Key="MonitorBorderBrush" Color="#33FFFFFF"/>
    <!-- 细滚动条滑块 -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#70FFFFFF"/>
    <!-- 滑块（Slider） -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#48484A"/>
    <SolidColorBrush x:Key="SliderFillBrush" Color="#0A84FF"/>
    <!-- 列表项柔和高亮（Apple 风：系统蓝叠加，而非灰色块） -->
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#330A84FF"/>
    <!-- 勾选框（CheckBox） -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#5A5A5E"/>
    <SolidColorBrush x:Key="CheckBoxFillBrush" Color="#0A84FF"/>
    <SolidColorBrush x:Key="CheckBoxGlyphBrush" Color="#FFFFFF"/>
    <!-- 右键菜单（Apple 风：深灰半透明材质背景 + 实心强调色高亮） -->
    <SolidColorBrush x:Key="MenuBgBrush" Color="#E62C2C2E"/>
    <SolidColorBrush x:Key="MenuHighlightBrush" Color="#0A84FF"/>
    <SolidColorBrush x:Key="MenuHighlightTextBrush" Color="#FFFFFF"/>
</ResourceDictionary>
