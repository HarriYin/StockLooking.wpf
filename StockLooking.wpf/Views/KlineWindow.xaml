<Window x:Class="StockLooking.wpf.Views.KlineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StockLooking.wpf.Views"
        Title="K线" Height="660" Width="1040"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Resources/stock-up.ico"
        FontFamily="Microsoft YaHei, SimSun, sans-serif"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" Grid.Row="0" Margin="16,12,16,8"
                   FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
        <!-- 与「行情明细」页共用同一 KlineChart 控件，保证周期/曲线/自动刷新/缩放/平移/悬停详情完全一致 -->
        <views:KlineChart x:Name="Kline" Grid.Row="1" Margin="12,0,12,12"/>
    </Grid>
</Window>
