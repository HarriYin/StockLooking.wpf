<UserControl x:Class="StockLooking.wpf.Views.MultiKlineChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:StockLooking.wpf.Converters"
             xmlns:views="clr-namespace:StockLooking.wpf.Views"
             xmlns:models="clr-namespace:StockLooking.wpf.Models"
             FontFamily="Microsoft YaHei, SimSun, sans-serif" FontSize="13"
             Foreground="{DynamicResource TextPrimaryBrush}">
    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
        <!-- Apple 风通用按钮（与 KlineChart 一致；本控件自成一份，避免依赖宿主资源） -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PressedBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BorderLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左：K 线图 ===== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,2,0,6">
                <!-- 注：大盘指数叠加已按需求移到「行情明细」页（KlineChart），本页不再提供 -->
                <WrapPanel Orientation="Horizontal">
                    <Button x:Name="BtnPeriodIntraday" Content="分时" Tag="intraday" Click="PeriodBtn_Click" Margin="0,0,4,0"/>
                    <Button x:Name="BtnPeriodDaily" Content="日线" Tag="101" Click="PeriodBtn_Click" Margin="0,0,4,0"/>
                    <Button x:Name="BtnPeriodWeekly" Content="周线" Tag="102" Click="PeriodBtn_Click" Margin="0,0,4,0"/>
                    <Button x:Name="BtnPeriodMonthly" Content="月线" Tag="103" Click="PeriodBtn_Click" Margin="0,0,8,0"/>
                    <Button x:Name="RefreshKlineBtn" Content="刷新" Width="70" Click="RefreshKline_Click" Margin="0,0,16,0"/>
                    <!-- 多股叠加总开关：勾选后容器内多只票同时绘制；取消则只画主票 -->
                    <CheckBox x:Name="ChkMulti" Content="显示多只股票K线" Margin="0,0,18,0" VerticalAlignment="Center"
                              Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <!-- K线末端名称标签（底色 = 该票线色） -->
                    <CheckBox x:Name="ChkShowName" Content="显示K线名称" Margin="0,0,18,0" VerticalAlignment="Center"
                              Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <CheckBox x:Name="ChkShowPrice" Content="价格线" IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center" Click="KlineCurve_Changed"/>
                    <CheckBox x:Name="ChkShowAvg" Content="均价线" IsChecked="False" Margin="0,0,14,0" VerticalAlignment="Center" Click="KlineCurve_Changed"/>
                    <CheckBox x:Name="ChkShowExtreme" Content="最高/最低" IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center"
                              Click="KlineCurve_Changed" ToolTip="分时图上按各票线色标出最高价 / 最低价的点与数值（全局设置，与行情明细页同步）"/>
                    <CheckBox x:Name="KlineAutoChk" Content="自动刷新" Margin="0,0,14,0" VerticalAlignment="Center" Checked="KlineAutoChk_Changed" Unchecked="KlineAutoChk_Changed"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="频率(ms)：" VerticalAlignment="Center"/>
                        <Slider x:Name="KlineRefreshSlider" Minimum="1000" Maximum="30000" TickFrequency="1000" IsSnapToTickEnabled="True" Width="180" ValueChanged="KlineRefreshSlider_ValueChanged"/>
                        <TextBlock x:Name="KlineRefreshText" VerticalAlignment="Center" Margin="10,0,0,0" Width="64"/>
                    </StackPanel>
                </WrapPanel>
                <Grid Margin="2,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DetailStatus" Grid.Column="0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="滚轮缩放 · 按住左键拖动平移 · 悬停查看各票数值"
                               VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                </Grid>
            </StackPanel>

            <!-- 绘图区（固定深色底 #0E0E0E，与 KlineChart 一致）；票名/涨跌幅改由 K 线末端的名称标签承担 -->
            <Border Grid.Row="1" Background="#0E0E0E" CornerRadius="12" Margin="0,0,0,8" ClipToBounds="True">
                <Grid>
                    <Canvas x:Name="KlineCanvas" Background="Transparent" Cursor="Cross"
                            SizeChanged="KlineCanvas_SizeChanged"
                            MouseMove="KlineCanvas_MouseMove"
                            MouseLeave="KlineCanvas_MouseLeave"
                            MouseWheel="KlineCanvas_MouseWheel"
                            MouseLeftButtonDown="KlineCanvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="KlineCanvas_MouseLeftButtonUp"/>
                    <Canvas x:Name="KlineOverlay" Background="Transparent" IsHitTestVisible="False"/>
                    <Border x:Name="KlineInfoPanel" Visibility="Collapsed" IsHitTestVisible="False"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                            Background="#D9000000" CornerRadius="8" Padding="10,7"
                            BorderBrush="#33FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="KlineInfoText" Foreground="#F0F0F0" FontSize="12"
                                       FontFamily="Consolas, Microsoft YaHei" LineHeight="18"/>
                            <Canvas x:Name="MiniTrendCanvas" Width="190" Height="56" Margin="0,7,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="MiniTrendHint" Margin="0,5,0,0" FontSize="10.5"
                                       Foreground="#9A9A9E" TextWrapping="Wrap" MaxWidth="190" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 右：股票容器 ===== -->
        <Border Grid.Column="1" Width="248" Margin="10,0,0,8" Padding="8"
                Background="{DynamicResource CardBgBrush}" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <views:StockSearchBox x:Name="MultiSearchBox" Grid.Row="0"/>

                <Grid Grid.Row="1" Margin="0,8,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ContainerCountText" Grid.Column="0" Text="容器 0 只"
                               VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <!-- 一键勾选（单个按钮，标签随状态切换）：未全选 →「全选」；已全选 →「全不选」 -->
                    <Button x:Name="SelectAllBtn" Grid.Column="1" Content="全选" Width="56" Padding="0,5" Margin="0,0,5,0"
                            ToolTip="一键全选 / 全不选（全部显示 / 全部隐藏）" Click="ToggleSelectAll_Click"/>
                    <Button Grid.Column="2" Content="清空" Width="52" Padding="0,5" Click="ClearAll_Click"/>
                </Grid>

                <ListBox x:Name="StockContainer" Grid.Row="2"
                         ItemsSource="{Binding}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="Container_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <!-- 自绘容器：圆角 + 无边框，选中用 PressedBgBrush（跨主题都比 Hover 明显一档） -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="6,5"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="RowBd" CornerRadius="8" Background="Transparent"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource PressedBgBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:MultiStockItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 最左侧竖线 = 该票在 K 线图中的颜色 -->
                                <Border Grid.Column="0" Width="3" MinHeight="16" CornerRadius="1.5" Margin="0,0,7,0"
                                        VerticalAlignment="Stretch"
                                        Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                        ToolTip="该票在K线图中的颜色"/>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0,0,7,0"
                                          IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                          Checked="ItemVisible_Changed" Unchecked="ItemVisible_Changed"
                                          ToolTip="勾选时在K线图中显示该票"/>
                                <TextBlock Grid.Column="2" Text="{Binding Display}" FontSize="12.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Button Grid.Column="3" Content="×" Width="20" Height="20" Padding="0" Margin="6,0,0,0"
                                        ToolTip="从容器与K线图中删除该票" Click="ItemDelete_Click"
                                        Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="3" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="提示：竖线=该票线色；勾选控制是否在K线图中显示；单击某票可设为副图基准票；容器最多 50 只。"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
