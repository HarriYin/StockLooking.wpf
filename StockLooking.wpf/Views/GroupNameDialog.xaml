<Window x:Class="StockLooking.wpf.Views.GroupNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="分组名称" Width="392" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei, SimSun, sans-serif" FontSize="13"
        Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HintText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBox x:Name="NameBox" Grid.Row="1" TextChanged="NameBox_TextChanged"/>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="#FF4438" Visibility="Collapsed"/>
        <!-- 按钮行用 Auto：配合窗口 SizeToContent 才不会被裁（原固定 Height + "*" 行导致按钮显示不全） -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkBtn" Content="确定" Width="84" IsDefault="True" Click="Ok_Click"/>
            <Button x:Name="CancelBtn" Content="取消" Width="84" Margin="10,0,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
