<Window x:Class="StockLooking.wpf.Views.TrendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="分时图" Height="480" Width="900"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Resources/stock-up.ico"
        FontFamily="Microsoft YaHei, SimSun, sans-serif"
        Background="#0E0E0E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" Margin="14,12,14,8" Foreground="#F0F0F0"
                   FontSize="13.5" FontWeight="SemiBold"/>
        <Border Grid.Row="1" Margin="12,0,12,6" Background="#141414" CornerRadius="8" ClipToBounds="True">
            <Grid>
                <!-- 数据层：坐标轴 / 曲线 / 量柱 -->
                <Canvas x:Name="TrendCanvas" Background="Transparent" Cursor="Cross"
                        SizeChanged="TrendCanvas_SizeChanged"
                        MouseMove="TrendCanvas_MouseMove"
                        MouseLeave="TrendCanvas_MouseLeave"/>
                <!-- 十字光标层：高频重绘，与数据层分离，避免鼠标移动时重建全部图元 -->
                <Canvas x:Name="TrendOverlay" Background="Transparent" IsHitTestVisible="False"/>
                <!-- 悬停详情：显示选中时刻的全部信息 -->
                <Border x:Name="InfoPanel" Visibility="Collapsed" IsHitTestVisible="False"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                        Background="#D9000000" CornerRadius="8" Padding="10,7"
                        BorderBrush="#33FFFFFF" BorderThickness="1">
                    <TextBlock x:Name="InfoText" Foreground="#F0F0F0" FontSize="12"
                               FontFamily="Consolas, Microsoft YaHei" LineHeight="18"/>
                </Border>
            </Grid>
        </Border>
        <TextBlock Grid.Row="2" Margin="14,0,14,10" FontSize="11.5" Foreground="#9A9A9E"
                   Text="鼠标移入查看该时刻全部信息（价格 / 涨跌 / 均价 / 成交额）"/>
    </Grid>
</Window>
