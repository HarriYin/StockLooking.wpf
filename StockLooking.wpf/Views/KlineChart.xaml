<UserControl x:Class="StockLooking.wpf.Views.KlineChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:StockLooking.wpf.Converters"
             FontFamily="Microsoft YaHei, SimSun, sans-serif" FontSize="13"
             Foreground="{DynamicResource TextPrimaryBrush}">
    <UserControl.Resources>
        <!-- Apple 风：通用按钮（与 MainWindow 一致；App.xaml 无全局 Button 样式） -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PressedBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BorderLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--
            工具栏：周期 + 曲线显隐 + 自动刷新。
            按钮与显示选项**合并为一排**（宽度不够时 WrapPanel 自动换行），操作提示并入状态行右侧。
            原因：纵向空间守恒 —— 顶部省下的每一像素都会直接加给下方绘图区（副图柱体行 / 主图）。
        -->
        <StackPanel Grid.Row="0" Margin="0,2,0,6">
            <!--
                注：「大盘 / 个股」选择行（大盘勾选项 + 个股下拉框）在宿主 MainWindow 的明细页里，
                与本控件同处一行（见 MainWindow.xaml 的 KlineTab）。本图一次只画一条系列。
            -->
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="BtnPeriodIntraday" Content="分时" Tag="intraday" Click="PeriodBtn_Click" Margin="0,0,4,0"/>
                <Button x:Name="BtnPeriodDaily" Content="日线" Tag="101" Click="PeriodBtn_Click" Margin="0,0,4,0"/>
                <Button x:Name="BtnPeriodWeekly" Content="周线" Tag="102" Click="PeriodBtn_Click" Margin="0,0,4,0"/>
                <Button x:Name="BtnPeriodMonthly" Content="月线" Tag="103" Click="PeriodBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="RefreshKlineBtn" Content="刷新" Width="70" Click="RefreshKline_Click" Margin="0,0,16,0"/>
                <CheckBox x:Name="ChkShowPrice" Content="价格线" IsChecked="True" Margin="0,0,18,0" VerticalAlignment="Center" Click="KlineCurve_Changed"/>
                <CheckBox x:Name="ChkShowAvg" Content="均价线" IsChecked="False" Margin="0,0,18,0" VerticalAlignment="Center" Click="KlineCurve_Changed"/>
                <CheckBox x:Name="ChkShowExtreme" Content="最高/最低" IsChecked="True" Margin="0,0,18,0" VerticalAlignment="Center"
                          Click="KlineCurve_Changed" ToolTip="分时图上标出当日最高价 / 最低价的点与数值（全局设置，多股K线页与分时弹窗同步）"/>
                <CheckBox x:Name="KlineAutoChk" Content="自动刷新" Margin="0,0,18,0" VerticalAlignment="Center" Checked="KlineAutoChk_Changed" Unchecked="KlineAutoChk_Changed"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="频率(ms)：" VerticalAlignment="Center"/>
                    <Slider x:Name="KlineRefreshSlider" Minimum="1000" Maximum="30000" TickFrequency="1000" IsSnapToTickEnabled="True" Width="200" ValueChanged="KlineRefreshSlider_ValueChanged"/>
                    <TextBlock x:Name="KlineRefreshText" VerticalAlignment="Center" Margin="10,0,0,0" Width="64"/>
                </StackPanel>
            </WrapPanel>
            <!-- 状态与操作提示同排：左=数据状态，右=操作提示（原来各占一行，浪费约 22px 绘图高度） -->
            <Grid Margin="2,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DetailStatus" Grid.Column="0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="滚轮缩放 · 按住左键拖动平移 · 鼠标移入查看该点详情"
                           HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="12,0,0,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
            </Grid>
        </StackPanel>

        <!-- 绘图区：最新价徽标 + 主图 + 成交量 + MACD（多段同屏） -->
        <Border Grid.Row="1" Background="#0E0E0E" CornerRadius="12" Margin="0,0,0,8" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 当前股票标识（板块胶囊 + 名称 + 代码）+ 最新价 / 涨跌额 / 涨跌幅，整组居中。
                     注意：绘图区是固定深色底（#0E0E0E），此处一律用固定浅色而非主题画笔，
                     否则浅色主题下会变成黑字、在深色图上不可读。 -->
                <StackPanel x:Name="LatestPanel" Grid.Row="0" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,2,0,2" IsHitTestVisible="False">
                    <Border x:Name="HeaderSectorTag" CornerRadius="3" Padding="5,1" Margin="0,0,9,0"
                            VerticalAlignment="Center" Background="#8E8E93">
                        <TextBlock x:Name="HeaderSectorText" FontSize="11" Foreground="White"/>
                    </Border>
                    <TextBlock x:Name="HeaderNameText" FontSize="13.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="#F0F0F0"/>
                    <TextBlock x:Name="HeaderCodeText" FontSize="11.5" Margin="7,0,0,0"
                               VerticalAlignment="Center" Foreground="#9A9A9E"/>
                    <TextBlock x:Name="LatestPriceText" Text="—" FontSize="20" FontWeight="Bold"
                               FontFamily="Consolas, Microsoft YaHei" VerticalAlignment="Center"
                               Margin="12,0,0,0" Foreground="#8A8A8E"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="LatestChangeText" Text="" FontSize="12.5" Margin="0,0,10,0"
                                   FontFamily="Consolas, Microsoft YaHei" Foreground="#8A8A8E"/>
                        <TextBlock x:Name="LatestPctText" Text="" FontSize="12.5"
                                   FontFamily="Consolas, Microsoft YaHei" Foreground="#8A8A8E"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Canvas x:Name="KlineCanvas" Background="Transparent" Cursor="Cross"
                            SizeChanged="KlineCanvas_SizeChanged"
                            MouseMove="KlineCanvas_MouseMove"
                            MouseLeave="KlineCanvas_MouseLeave"
                            MouseWheel="KlineCanvas_MouseWheel"
                            MouseLeftButtonDown="KlineCanvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="KlineCanvas_MouseLeftButtonUp"/>
                    <!-- 十字光标层：高频重绘，与数据层分离，避免鼠标移动时重建全部图元 -->
                    <Canvas x:Name="KlineOverlay" Background="Transparent" IsHitTestVisible="False"/>
                    <!-- 悬停详情：显示选中点的全部信息 -->
                    <Border x:Name="KlineInfoPanel" Visibility="Collapsed" IsHitTestVisible="False"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                            Background="#D9000000" CornerRadius="8" Padding="10,7"
                            BorderBrush="#33FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="KlineInfoText" Foreground="#F0F0F0" FontSize="12"
                                       FontFamily="Consolas, Microsoft YaHei" LineHeight="18"/>
                            <!-- 该日分时迷你图（日/周/月线悬停时显示；双击看大图） -->
                            <Canvas x:Name="MiniTrendCanvas" Width="190" Height="56" Margin="0,7,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="MiniTrendHint" Margin="0,5,0,0" FontSize="10.5"
                                       Foreground="#9A9A9E" TextWrapping="Wrap" MaxWidth="190" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
