<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 应用图标：exe 资源管理器/任务栏显示 -->
    <ApplicationIcon>Resources\stock-up.ico</ApplicationIcon>
    <Authors>Harri</Authors>
    <Product>StockLooking</Product>
    <Description>Stock monitoring software implemented based on WPF</Description>
    <PackageIcon>stock-up.ico</PackageIcon>
    <RepositoryUrl>https://github.com/HarriYin/StockLooking.wpf/tree/master/StockLooking.wpf</RepositoryUrl>
    <AssemblyVersion>1.0.1.16</AssemblyVersion>
    <FileVersion>1.0.1.16</FileVersion>
    <AssemblyName>StockLooking</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\stock-up.ico">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 嵌入为 WPF 资源，供 Window.Icon 与托盘 NotifyIcon 运行时加载 -->
    <Resource Include="Resources\stock-up.ico" />
  </ItemGroup>

</Project>
